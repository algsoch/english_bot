# Environment Configuration Template
ENVIRONMENT=development

# AI Provider Configuration (auto = detect based on environment)
AI_PROVIDER=auto

# Groq API (Production) - Replace with your actual API key
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local Development)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/englishbot

# App Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# CORS (for online sharing)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000